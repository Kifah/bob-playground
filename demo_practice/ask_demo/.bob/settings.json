{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(write_file|apply_diff|search_and_replace|insert_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh .bob/hooks/guard-writes.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
